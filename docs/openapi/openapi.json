{
  "openapi": "3.1.0",
  "info": {
    "title": "Wearly Services API",
    "version": "1.0.0",
    "description": "Consolidated contract for every /api/v1 route registered in terraform/main.tf. Unless an operation says otherwise, successful object results use the { body: ... } envelope. See promotions.openapi.json for promotion rule compatibility notes."
  },
  "tags": [
    { "name": "Auth" },
    { "name": "Catalog" },
    { "name": "Customers" },
    { "name": "Inventory" },
    { "name": "Promotions" },
    { "name": "Reporting" },
    { "name": "Sales" }
  ],
  "paths": {
    "/api/v1/products": {
      "get": {
        "tags": ["Catalog"],
        "summary": "List products",
        "parameters": [
          { "$ref": "#/components/parameters/Q" },
          { "$ref": "#/components/parameters/CategoryId" },
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PageSize" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Products" },
          "401": { "$ref": "#/components/responses/Error" }
        }
      },
      "post": {
        "tags": ["Catalog"],
        "summary": "Create product",
        "requestBody": { "$ref": "#/components/requestBodies/CreateProduct" },
        "responses": {
          "200": { "$ref": "#/components/responses/Id" },
          "400": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/products/{id}": {
      "get": {
        "tags": ["Catalog"],
        "summary": "Get product",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "responses": {
          "200": { "$ref": "#/components/responses/Product" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      },
      "patch": {
        "tags": ["Catalog"],
        "summary": "Update product",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "requestBody": { "$ref": "#/components/requestBodies/UpdateProduct" },
        "responses": {
          "200": { "$ref": "#/components/responses/Id" },
          "400": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      },
      "delete": {
        "tags": ["Catalog"],
        "summary": "Deactivate product",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "responses": {
          "200": { "$ref": "#/components/responses/Deactivated" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/variants": {
      "get": {
        "tags": ["Catalog"],
        "summary": "List product variants",
        "parameters": [
          { "$ref": "#/components/parameters/ProductId" },
          { "$ref": "#/components/parameters/Q" },
          { "$ref": "#/components/parameters/Barcode" },
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PageSize" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Variants" },
          "401": { "$ref": "#/components/responses/Error" }
        }
      },
      "post": {
        "tags": ["Catalog"],
        "summary": "Create product variant",
        "requestBody": { "$ref": "#/components/requestBodies/CreateVariant" },
        "responses": {
          "200": { "$ref": "#/components/responses/Id" },
          "400": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/variants/{id}": {
      "get": {
        "tags": ["Catalog"],
        "summary": "Get product variant",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "responses": {
          "200": { "$ref": "#/components/responses/Variant" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      },
      "patch": {
        "tags": ["Catalog"],
        "summary": "Update product variant",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "requestBody": { "$ref": "#/components/requestBodies/UpdateVariant" },
        "responses": {
          "200": { "$ref": "#/components/responses/Id" },
          "400": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      },
      "delete": {
        "tags": ["Catalog"],
        "summary": "Deactivate product variant",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "responses": {
          "200": { "$ref": "#/components/responses/Deactivated" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/customers": {
      "get": {
        "tags": ["Customers"],
        "summary": "List customers",
        "parameters": [{ "$ref": "#/components/parameters/Q" }, { "$ref": "#/components/parameters/Active" }],
        "responses": {
          "200": { "$ref": "#/components/responses/Customers" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      },
      "post": {
        "tags": ["Customers"],
        "summary": "Create customer",
        "requestBody": { "$ref": "#/components/requestBodies/CreateCustomer" },
        "responses": {
          "200": { "$ref": "#/components/responses/Id" },
          "400": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/customers/{id}": {
      "patch": {
        "tags": ["Customers"],
        "summary": "Update customer",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "requestBody": { "$ref": "#/components/requestBodies/UpdateCustomer" },
        "responses": {
          "200": { "description": "Current handler has no stable success payload." },
          "400": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/customers/{id}/sales": {
      "get": {
        "tags": ["Customers"],
        "summary": "Get customer sale history",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "responses": {
          "200": { "$ref": "#/components/responses/CustomerSales" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/inventory": {
      "get": {
        "tags": ["Inventory"],
        "summary": "Get inventory",
        "parameters": [{ "$ref": "#/components/parameters/VariantId" }],
        "responses": {
          "200": { "$ref": "#/components/responses/Envelope" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/inventory/adjustments": {
      "post": {
        "tags": ["Inventory"],
        "summary": "Adjust inventory",
        "requestBody": { "$ref": "#/components/requestBodies/InventoryAdjustment" },
        "responses": {
          "200": { "$ref": "#/components/responses/Id" },
          "400": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/inventory/movements": {
      "get": {
        "tags": ["Inventory"],
        "summary": "List inventory movements",
        "parameters": [{ "$ref": "#/components/parameters/VariantId" }],
        "responses": {
          "200": { "$ref": "#/components/responses/Movements" },
          "400": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/promotions": {
      "get": {
        "tags": ["Promotions"],
        "summary": "List promotions",
        "description": "active=true is currently unreliable; it falls through to the management list.",
        "parameters": [{ "$ref": "#/components/parameters/Active" }],
        "responses": {
          "200": { "$ref": "#/components/responses/Promotions" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      },
      "post": {
        "tags": ["Promotions"],
        "summary": "Create promotion",
        "requestBody": { "$ref": "#/components/requestBodies/CreatePromotion" },
        "responses": {
          "200": { "$ref": "#/components/responses/Id" },
          "400": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/promotions/{id}": {
      "patch": {
        "tags": ["Promotions"],
        "summary": "Update, activate, or deactivate promotion",
        "description": "Current handler has no stable success payload.",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "requestBody": { "$ref": "#/components/requestBodies/UpdatePromotion" },
        "responses": {
          "200": { "description": "Success response is not stable." },
          "400": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/reports/best-sellers": {
      "get": {
        "tags": ["Reporting"],
        "summary": "Get best sellers report",
        "parameters": [
          { "$ref": "#/components/parameters/From" },
          { "$ref": "#/components/parameters/To" },
          { "$ref": "#/components/parameters/TimeZone" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/BestSellersReport" },
          "400": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/reports/daily-sales": {
      "get": {
        "tags": ["Reporting"],
        "summary": "Get daily sales report",
        "description": "Compatibility view of a one-day sales overview. Prefer /sales-overview.",
        "parameters": [{ "$ref": "#/components/parameters/Date" }, { "$ref": "#/components/parameters/TimeZone" }],
        "responses": {
          "200": { "$ref": "#/components/responses/SalesOverviewReport" },
          "400": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/reports/low-stock": {
      "get": {
        "tags": ["Reporting"],
        "summary": "Get low stock report",
        "responses": { "200": { "$ref": "#/components/responses/LowStockReport" } }
      }
    },
    "/api/v1/reports/sales-overview": {
      "get": {
        "tags": ["Reporting"],
        "summary": "Get sales totals and a zero-filled local-day series",
        "parameters": [
          { "$ref": "#/components/parameters/From" },
          { "$ref": "#/components/parameters/To" },
          { "$ref": "#/components/parameters/TimeZone" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/SalesOverviewReport" },
          "400": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/sales": {
      "get": {
        "tags": ["Sales"],
        "summary": "List sales",
        "responses": { "200": { "$ref": "#/components/responses/Sales" } }
      },
      "post": {
        "tags": ["Sales"],
        "summary": "Complete a checkout quote",
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "$ref": "#/components/requestBodies/CompleteQuoteSale" },
        "responses": {
          "200": { "$ref": "#/components/responses/Envelope" },
          "400": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/sales/idempotency/{key}": {
      "get": {
        "tags": ["Sales"],
        "summary": "Get sale idempotency status",
        "parameters": [{ "$ref": "#/components/parameters/Key" }],
        "responses": {
          "200": { "$ref": "#/components/responses/Envelope" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/sales/{id}": {
      "get": {
        "tags": ["Sales"],
        "summary": "Get sale",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "responses": {
          "200": { "$ref": "#/components/responses/Envelope" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/checkout/quote": {
      "post": {
        "tags": ["Sales"],
        "summary": "Create checkout quote",
        "requestBody": { "$ref": "#/components/requestBodies/CheckoutQuote" },
        "responses": {
          "200": { "$ref": "#/components/responses/Envelope" },
          "400": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/session": {
      "get": {
        "tags": ["Auth"],
        "summary": "Get authenticated session",
        "responses": {
          "200": { "$ref": "#/components/responses/Envelope" },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/session/store": {
      "post": {
        "tags": ["Auth"],
        "summary": "Select store context",
        "requestBody": { "$ref": "#/components/requestBodies/SelectStore" },
        "responses": {
          "200": { "$ref": "#/components/responses/Envelope" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": { "BearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" } },
    "parameters": {
      "Id": { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
      "Key": { "name": "key", "in": "path", "required": true, "schema": { "type": "string" } },
      "Q": { "name": "q", "in": "query", "schema": { "type": "string" } },
      "CategoryId": { "name": "categoryId", "in": "query", "schema": { "type": "string" } },
      "ProductId": { "name": "productId", "in": "query", "schema": { "type": "string" } },
      "VariantId": { "name": "variantId", "in": "query", "schema": { "type": "string" } },
      "Barcode": { "name": "barcode", "in": "query", "schema": { "type": "string" } },
      "Active": { "name": "active", "in": "query", "schema": { "type": "boolean" } },
      "Page": { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1 } },
      "PageSize": { "name": "pageSize", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100 } },
      "From": { "name": "from", "in": "query", "schema": { "type": "string", "format": "date" } },
      "To": { "name": "to", "in": "query", "schema": { "type": "string", "format": "date" } },
      "Date": { "name": "date", "in": "query", "schema": { "type": "string", "format": "date" } },
      "TimeZone": {
        "name": "timeZone",
        "in": "query",
        "required": true,
        "schema": { "type": "string", "example": "America/Merida" }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      }
    },
    "requestBodies": {
      "CreateProduct": {
        "required": true,
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateProduct" } } }
      },
      "UpdateProduct": {
        "required": true,
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateProduct" } } }
      },
      "CreateVariant": {
        "required": true,
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateVariant" } } }
      },
      "UpdateVariant": {
        "required": true,
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateVariant" } } }
      },
      "CreateCustomer": {
        "required": true,
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateCustomer" } } }
      },
      "UpdateCustomer": {
        "required": true,
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateCustomer" } } }
      },
      "InventoryAdjustment": {
        "required": true,
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/InventoryAdjustment" } } }
      },
      "CreatePromotion": {
        "required": true,
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreatePromotion" } } }
      },
      "UpdatePromotion": {
        "required": true,
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdatePromotion" } } }
      },
      "CheckoutQuote": {
        "required": true,
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CheckoutQuoteRequest" } } }
      },
      "CompleteQuoteSale": {
        "required": true,
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CompleteQuoteSaleRequest" } } }
      },
      "SelectStore": {
        "required": true,
        "content": {
          "application/json": {
            "schema": { "type": "object", "required": ["storeId"], "properties": { "storeId": { "type": "string" } } }
          }
        }
      }
    },
    "responses": {
      "Error": {
        "description": "API error",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
      },
      "Envelope": {
        "description": "Successful response",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } }
      },
      "Id": {
        "description": "Created or updated ID",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/IdEnvelope" } } }
      },
      "Deactivated": {
        "description": "Deactivated resource",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeactivatedEnvelope" } } }
      },
      "Products": {
        "description": "Product discovery page",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } }
      },
      "Variants": {
        "description": "Variant discovery page",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } }
      },
      "Product": {
        "description": "Product",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } }
      },
      "Variant": {
        "description": "Variant",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } }
      },
      "Customers": {
        "description": "Customer list",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } }
      },
      "CustomerSales": {
        "description": "Customer sales",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } }
      },
      "Movements": {
        "description": "Inventory movements",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } }
      },
      "Promotions": {
        "description": "Promotion list",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } }
      },
      "Sales": {
        "description": "Sale list",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } }
      },
      "SalesOverviewReport": {
        "description": "Sales overview response",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SalesOverviewEnvelope" } } }
      },
      "BestSellersReport": {
        "description": "Best sellers response",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BestSellersEnvelope" } } }
      },
      "LowStockReport": {
        "description": "Low stock response",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LowStockEnvelope" } } }
      }
    },
    "schemas": {
      "Envelope": {
        "type": "object",
        "required": ["body"],
        "properties": { "body": { "type": "object", "additionalProperties": true } }
      },
      "ReportMeta": {
        "type": "object",
        "required": ["storeId", "currency", "timeZone"],
        "properties": {
          "storeId": { "type": "string" },
          "currency": { "type": "string", "example": "USD" },
          "timeZone": { "type": "string", "example": "America/Merida" },
          "period": {
            "type": "object",
            "required": ["from", "to"],
            "properties": {
              "from": { "type": "string", "format": "date" },
              "to": { "type": "string", "format": "date" }
            }
          }
        }
      },
      "SalesTotals": {
        "type": "object",
        "required": ["saleCount", "itemQuantity", "subtotal", "discount", "tax", "total"],
        "properties": {
          "saleCount": { "type": "integer", "example": 2 },
          "itemQuantity": { "type": "integer", "example": 3 },
          "subtotal": { "type": "number", "example": 120 },
          "discount": { "type": "number", "example": 10 },
          "tax": { "type": "number", "example": 17.6 },
          "total": { "type": "number", "example": 127.6 }
        }
      },
      "SalesOverviewEnvelope": {
        "type": "object",
        "required": ["body"],
        "properties": {
          "body": {
            "type": "object",
            "required": ["meta", "totals", "series"],
            "properties": {
              "meta": { "$ref": "#/components/schemas/ReportMeta" },
              "totals": { "$ref": "#/components/schemas/SalesTotals" },
              "series": {
                "type": "array",
                "items": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SalesTotals" },
                    {
                      "type": "object",
                      "required": ["date"],
                      "properties": { "date": { "type": "string", "format": "date" } }
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "BestSellersEnvelope": {
        "type": "object",
        "required": ["body"],
        "properties": {
          "body": {
            "type": "object",
            "required": ["meta", "items"],
            "properties": {
              "meta": { "$ref": "#/components/schemas/ReportMeta" },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "rank",
                    "productVariantId",
                    "productId",
                    "productName",
                    "variantName",
                    "sku",
                    "quantitySold",
                    "grossSales",
                    "discount",
                    "netSales"
                  ],
                  "properties": {
                    "rank": { "type": "integer" },
                    "productVariantId": { "type": "string" },
                    "productId": { "type": "string" },
                    "productName": { "type": "string" },
                    "variantName": { "type": "string" },
                    "sku": { "type": "string" },
                    "barcode": { "type": "string" },
                    "quantitySold": { "type": "integer" },
                    "grossSales": { "type": "number" },
                    "discount": { "type": "number" },
                    "netSales": { "type": "number" }
                  }
                }
              }
            }
          }
        }
      },
      "LowStockEnvelope": {
        "type": "object",
        "required": ["body"],
        "properties": {
          "body": {
            "type": "object",
            "required": ["meta", "items"],
            "properties": {
              "meta": { "$ref": "#/components/schemas/ReportMeta" },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "productVariantId",
                    "productId",
                    "productName",
                    "variantName",
                    "sku",
                    "stock",
                    "minimumStock",
                    "shortageQuantity"
                  ],
                  "properties": {
                    "productVariantId": { "type": "string" },
                    "productId": { "type": "string" },
                    "productName": { "type": "string" },
                    "variantName": { "type": "string" },
                    "sku": { "type": "string" },
                    "barcode": { "type": "string" },
                    "stock": { "type": "integer" },
                    "minimumStock": { "type": "integer" },
                    "shortageQuantity": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      },
      "IdEnvelope": {
        "type": "object",
        "required": ["body"],
        "properties": { "body": { "type": "object", "required": ["id"], "properties": { "id": { "type": "string" } } } }
      },
      "DeactivatedEnvelope": {
        "type": "object",
        "required": ["body"],
        "properties": {
          "body": {
            "type": "object",
            "required": ["id", "active"],
            "properties": { "id": { "type": "string" }, "active": { "const": false } }
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message", "details"],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "VALIDATION_ERROR",
                  "UNAUTHENTICATED",
                  "FORBIDDEN",
                  "NOT_FOUND",
                  "CONFLICT",
                  "STALE_PRICING",
                  "INSUFFICIENT_STOCK",
                  "IDEMPOTENCY_CONFLICT",
                  "INTERNAL_ERROR"
                ]
              },
              "message": { "type": "string" },
              "details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": { "field": { "type": "string" }, "message": { "type": "string" } }
                }
              }
            }
          }
        }
      },
      "CreateProduct": {
        "type": "object",
        "required": ["name", "price", "currency", "stock"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "price": { "type": "number" },
          "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
          "stock": { "type": "integer", "minimum": 0 }
        }
      },
      "UpdateProduct": { "type": "object", "minProperties": 1, "additionalProperties": true },
      "CreateVariant": {
        "type": "object",
        "required": ["productId", "sku", "price", "cost"],
        "properties": {
          "productId": { "type": "string" },
          "sku": { "type": "string" },
          "barcode": { "type": "string" },
          "size": { "type": "string" },
          "color": { "type": "string" },
          "price": { "type": "number" },
          "cost": { "type": "number" },
          "stock": { "type": "integer", "minimum": 0 },
          "minimumStock": { "type": "integer", "minimum": 0 }
        }
      },
      "UpdateVariant": { "type": "object", "minProperties": 1, "additionalProperties": true },
      "CreateCustomer": {
        "type": "object",
        "required": ["name"],
        "properties": { "name": { "type": "string" }, "phone": { "type": "string" }, "email": { "type": "string" } }
      },
      "UpdateCustomer": { "type": "object", "minProperties": 1, "additionalProperties": true },
      "InventoryAdjustment": {
        "type": "object",
        "required": ["productVariantId", "quantity", "reason"],
        "properties": {
          "productVariantId": { "type": "string" },
          "quantity": { "type": "integer" },
          "reason": { "type": "string" }
        }
      },
      "PromotionCondition": {
        "type": "object",
        "required": ["field", "operator", "value"],
        "properties": {
          "field": { "enum": ["category", "productId", "variantId", "quantity", "brand"] },
          "operator": { "enum": ["EQUALS", "IN", "GREATER_THAN_OR_EQUAL"] },
          "value": {
            "oneOf": [{ "type": "string" }, { "type": "number" }, { "type": "array", "items": { "type": "string" } }]
          }
        }
      },
      "PromotionAction": {
        "type": "object",
        "required": ["type", "value"],
        "properties": {
          "type": { "enum": ["SET_FIXED_PRICE", "PERCENTAGE_DISCOUNT", "FIXED_DISCOUNT", "CHEAPEST_ITEM_DISCOUNT"] },
          "value": { "type": "number", "minimum": 0 }
        }
      },
      "CreatePromotion": {
        "type": "object",
        "required": ["name", "type", "conditions", "actions", "priority"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "type": { "enum": ["FIXED_COMBO", "MIXED_COMBO", "PERCENTAGE_DISCOUNT", "BUY_X_GET_Y"] },
          "conditions": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/components/schemas/PromotionCondition" }
          },
          "actions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": { "$ref": "#/components/schemas/PromotionAction" }
          },
          "startsAt": { "type": "string", "format": "date-time" },
          "endsAt": { "type": "string", "format": "date-time" },
          "priority": { "type": "integer" },
          "active": { "type": "boolean" }
        }
      },
      "UpdatePromotion": { "type": "object", "minProperties": 1, "additionalProperties": true },
      "CheckoutQuoteRequest": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "customerId": { "type": "string" },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["variantId", "quantity"],
              "properties": { "variantId": { "type": "string" }, "quantity": { "type": "integer", "minimum": 1 } }
            }
          },
          "manualDiscount": {
            "type": "object",
            "required": ["amount", "reason"],
            "properties": {
              "amount": { "type": "string", "pattern": "^\\d+\\.\\d{2}$" },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      },
      "CompleteQuoteSaleRequest": {
        "type": "object",
        "required": ["quoteId", "paymentMethod"],
        "properties": {
          "quoteId": { "type": "string" },
          "paymentMethod": { "enum": ["CASH", "CARD", "TRANSFER"] },
          "tenderedAmount": { "type": "string", "pattern": "^\\d+\\.\\d{2}$" },
          "terminalTransactionReference": { "type": "string" },
          "transferReference": { "type": "string" }
        }
      }
    }
  },
  "security": [{ "BearerAuth": [] }]
}
